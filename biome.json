{
	"$schema": "https://biomejs.dev/schemas/2.1.1/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": [
			"**/*.ts",
			"**/*.tsx",
			"**/*.js",
			"**/*.jsx",
			"**/*.mjs",
			"**/*.cjs",
			"**/*.mts",
			"**/*.cts",
			"**/*.json",
			"**/*.jsonc",
			"!**/node_modules/**",
			"!**/dist/**",
			"!**/.nx/**",
			"!**/.angular/**",
			"!**/coverage/**",
			"!**/storybook-static/**",
			"!**/src-tauri/**",
			"!**/pnpm-lock.yaml"
		],
		"ignoreUnknown": true
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"linter": {
		"enabled": false
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "single"
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	}
}
