# Editor configuration, see http://editorconfig.org
# Indentation must mirror whichever formatter owns the file type, otherwise
# your editor and the formatter fight on every save.
#   .ts / .js / .json  -> Biome    (tabs)      see biome.json
#   everything else    -> Prettier (2 spaces)  see .prettierrc
root = true

[*]
charset = utf-8
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.{ts,tsx,js,jsx,mjs,cjs,json,jsonc}]
indent_style = tab

[*.md]
max_line_length = off
trim_trailing_whitespace = false
