{
  "name": "docsite",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "apps/docsite",
  "tags": [],
  "targets": {
    "build": {
			"executor": "nx:run-commands",
			"outputs": ["{workspaceRoot}/dist/apps/docsite"],
			"options": {
				"command": "vitepress build apps/docsite"
			}
		},
		"serve": {
			"executor": "nx:run-commands",
			"options": {
				"command": "vitepress dev apps/docsite"
			}
		},
    "lint": {
      "executor": "@nx/eslint:lint"
    },
  }
}
