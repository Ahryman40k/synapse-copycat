{
	"name": "synapse",
	"$schema": "../../node_modules/nx/schemas/project-schema.json",
	"projectType": "application",
	"prefix": "app",
	"sourceRoot": "apps/synapse/src",
	"tags": [],
	"targets": {
		"build": {
			"executor": "@angular/build:application",
			"outputs": ["{options.outputPath}"],
			"options": {
				"outputPath": "dist/apps/synapse",
				"browser": "apps/synapse/src/main.ts",
				"polyfills": [],
				"tsConfig": "apps/synapse/tsconfig.app.json",
				"inlineStyleLanguage": "scss",
				"assets": [
					{
						"glob": "**/public",
						"input": "apps/synapse/public"
					},
					"apps/synapse/src/config",
					"apps/synapse/src/assets"
				],
				"styles": ["apps/synapse/src/styles.scss"]
			},
			"configurations": {
				"production": {
					"budgets": [
						{
							"type": "initial",
							"maximumWarning": "500kb",
							"maximumError": "1mb"
						},
						{
							"type": "anyComponentStyle",
							"maximumWarning": "4kb",
							"maximumError": "8kb"
						}
					],
					"outputHashing": "all",
					"fileReplacements": [
						{
							"replace": "apps/synapse/src/config/app.json",
							"with": "apps/synapse/src/config/app.production.json"
						}
					]
				},
				"development": {
					"optimization": false,
					"extractLicenses": false,
					"sourceMap": true
				}
			},
			"defaultConfiguration": "production"
		},
		"tauri": {
			"executor": "nx:run-commands",
			"options": {
				"command": "CARGO_TARGET_DIR=../../../dist/apps/.target pnpm exec tauri dev"
			}
		},
		"serve": {
			"continuous": true,
			"executor": "@angular/build:dev-server",
			"configurations": {
				"production": {
					"buildTarget": "synapse:build:production"
				},
				"development": {
					"buildTarget": "synapse:build:development"
				}
			},
			"defaultConfiguration": "development"
		},
		"extract-i18n": {
			"executor": "@angular/build:extract-i18n",
			"options": {
				"buildTarget": "synapse:build"
			}
		},
		"lint": {
			"executor": "@nx/eslint:lint"
		},
		"test": {
			"executor": "@nx/vitest:test",
			"outputs": ["{options.reportsDirectory}"],
			"options": {
				"reportsDirectory": "{projectRoot}/../../coverage/apps/synapse"
			}
		},
		"serve-static": {
			"continuous": true,
			"executor": "@nx/web:file-server",
			"options": {
				"buildTarget": "synapse:build",
				"port": 4200,
				"staticFilePath": "dist/apps/synapse/browser",
				"spa": true
			}
		},
		"storybook": {
			"executor": "@storybook/angular:start-storybook",
			"options": {
				"port": 4400,
				"configDir": "apps/synapse/.storybook",
				"browserTarget": "synapse:build",
				"compodoc": true,
				"compodocArgs": [
					"-p",
					"apps/synapse/tsconfig.json",
					"-e",
					"json",
					"-d",
					"apps/synapse"
				],
				"styles": ["apps/synapse/src/styles.scss"]
			},
			"configurations": {
				"ci": {
					"quiet": true
				}
			}
		},
		"build-storybook": {
			"executor": "@storybook/angular:build-storybook",
			"outputs": ["{options.outputDir}"],
			"options": {
				"outputDir": "dist/storybook/synapse",
				"configDir": "apps/synapse/.storybook",
				"browserTarget": "synapse:build",
				"compodoc": true,
				"compodocArgs": [
					"-p",
					"apps/synapse/tsconfig.json",
					"-e",
					"json",
					"-d",
					"apps/synapse"
				],
				"styles": ["apps/synapse/src/styles.scss"]
			},
			"configurations": {
				"ci": {
					"quiet": true
				}
			}
		},
		"serve-storybook-static": {
			"executor": "@nx/web:file-server",
			"options": {
				"staticFilePath": "dist/storybook/synapse",
				"port": 6006,
				"spa": true,
				"watch": false
			}
		},
		"test-storybook": {
			"executor": "nx:run-commands",
			"dependsOn": ["build-storybook"],
			"cache": false,
			"options": {
				"command": "for _ in $(seq 1 20); do curl -sf -m 1 http://127.0.0.1:6006/index.html >/dev/null 2>&1 || break; sleep 0.5; done; if curl -sf -m 1 http://127.0.0.1:6006/index.html >/dev/null 2>&1; then echo 'port 6006 is still serving something after 10s - refusing to test it' >&2; exit 1; fi; pnpm exec start-server-and-test 'pnpm exec nx run synapse:serve-storybook-static' http://127.0.0.1:6006/index.html 'pnpm exec test-storybook --config-dir apps/synapse/.storybook --url http://127.0.0.1:6006'",
				"cwd": "."
			}
		}
	}
}
